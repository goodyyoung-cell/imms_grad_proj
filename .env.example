# 필요한 환경변수 이름만 적습니다. 실제 값은 .env에 넣고, .env는 커밋하지 않습니다.
# 배포 환경(Cloud Run)에서는 같은 이름으로 Secret Manager에 넣습니다 (docs/deploy.md).

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# Google AI Studio에서 현재 쓸 수 있는 모델명을 확인해 넣으세요
GEMINI_MODEL=
# 에이전트 루프 기본 모델: claude 또는 gemini
DEFAULT_LLM=claude
# 리드 한 건당 최대 LLM 호출 수 (한 번에 여러 도구를 부를 수 있음). 출처가 4종이라 12 권장
AGENT_MAX_STEPS=12

# DB (Supabase). 대시보드 Settings → API Keys의 Secret keys에서 sb_secret_... 값을 복사합니다.
# 모든 권한을 가진 키라 서버에서만 쓰고 브라우저·채팅·저장소에 노출하지 않습니다
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 리서치 도구 (https://opendart.fss.or.kr 에서 무료 발급)
DART_API_KEY=
# 네이버 뉴스 검색. 2026년 여름부터 네이버 클라우드 플랫폼 NAVER API HUB에서 신청한다 (없으면 Google 뉴스만 쓴다)
# 콘솔: Application Services > NAVER API HUB > Subscription 이용 신청 > Application 등록(검색) > 인증 정보의 Client ID/Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# hub(기본) 또는 legacy(예전 developers.naver.com 키)
NAVER_SEARCH_API=hub
# Google 뉴스 RSS는 키가 필요 없다. 끄려면 false
GOOGLE_NEWS_ENABLED=true

# /jobs/* 호출 보호용 토큰. 아무 긴 임의 문자열 (예: openssl rand -hex 32). 예약 실행·CLI용, 브라우저 코드에 넣지 않는다
JOB_TOKEN=

# 관리 화면 로그인 (docs/frontend-handoff.md). 팀이 공유하는 비밀번호 하나
ADMIN_PASSWORD=
# 로그인 토큰 서명 키 (비우면 JOB_TOKEN에서 만든다)
ADMIN_TOKEN_SECRET=
# 관리 화면이 API 서버와 다른 주소에서 뜰 때 허용할 출처, 쉼표로 구분 (비우면 localhost 개발 포트들)
ALLOWED_ORIGINS=

# 메일 CTA의 미팅 예약 링크 (비우면 링크 없이 미팅만 제안)
BOOKING_URL=
# 첫 메일 발송 후 전화 팔로업: 최소 몇 분 뒤, 전화해도 되는 시간대(평일, 한국 시간)
# 발송 1시간 뒤가 시간대 밖이면 다음 평일 시작 시각으로 옮긴다
CALL_DELAY_MINUTES=60
CALL_HOURS_KST=9-18
# 인계 자료를 받을 담당자 이름 또는 주소 (기록용. 알림 채널은 미정이라 지금은 서버 로그로만 나감)
HANDOFF_TO=

# 이메일 (개발 단계에서는 샌드박스 계정 사용, 서비스 미정)
EMAIL_PROVIDER_API_KEY=

# 승인 채널 Slack (docs/admin-slack.md). 토큰과 채널을 모두 넣어야 알림이 올라간다
SLACK_BOT_TOKEN=
# 버튼 클릭 요청의 서명 검증용. 없으면 /webhooks/slack/interactions 는 503
SLACK_SIGNING_SECRET=
# 알림을 올릴 채널 ID (C...)
SLACK_CHANNEL=
# 승인·반려할 수 있는 Slack 사용자 ID, 쉼표로 구분 (비우면 채널 구성원 모두. 운영에서는 채울 것)
SLACK_APPROVERS=
# Slack으로 보낼 알림 종류 (approval, needs_human, unsubscribe, handoff, followup, call_due, reminder, intake)
SLACK_NOTIFY_KINDS=approval,needs_human,unsubscribe,handoff,followup,call_due,reminder
# 관리 웹(React) 주소. 알림의 "관리 화면에서 열기" 링크 기준. 끝에 / 없이 (예: https://admin.example.app)
ADMIN_WEB_URL=
# 광고성 메일 표시 (정보통신망법 제50조 제4항). 메일 하단에 전송자 명칭·연락처를 밝힌다
SENDER_NAME=노바웍스
SENDER_CONTACT=
# 이 백엔드의 공개 주소(Cloud Run). 메일 하단의 수신 거부 링크 /unsubscribe/... 에만 쓴다. 비우면 링크를 넣지 않는다
PUBLIC_BASE_URL=
# 하루 발송 상한 (한국 시간 자정 기준, 0이면 제한 없음)
MAX_SENDS_PER_DAY=50
# true면 수신 동의 기록(consent_at)이 없는 리드에게는 보내지 않는다. 실제 발송을 켤 때 true로 한다
REQUIRE_CONSENT_TO_SEND=false
# 승인 대기가 이 시간(시간 단위)을 넘으면 /jobs/remind 가 Slack에 알린다
REMINDER_HOURS=4
