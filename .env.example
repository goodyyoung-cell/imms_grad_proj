# 필요한 환경변수 이름만 적습니다. 실제 값은 .env에 넣고, .env는 커밋하지 않습니다.
# 배포 환경(Cloud Run)에서는 같은 이름으로 Secret Manager에 넣습니다.

# LLM
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# DB (Supabase). service role 키는 서버에서만 사용하고 브라우저에 노출하지 않습니다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 리서치 도구
DART_API_KEY=

# 이메일 (개발 단계에서는 샌드박스 계정 사용, 서비스 미정)
EMAIL_PROVIDER_API_KEY=

# 승인 채널 (Slack 또는 이메일 중 미정. Slack을 쓰면 아래 두 값 사용)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
